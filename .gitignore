coverage/

# package.json, package-lock.json, eslint.config.mjs et scripts/ sont versionnes
# depuis la 26.8.6 : ils portent le lint et le script de build. Ils ne partent
# pas dans le zip, l'exclusion est faite explicitement par scripts/build-zip.mjs.

backups/
.agents/
memory.md

# Outillage local des agents : jamais versionne
.codex/
.impeccable/
.zcode/

# Intermediaires des captures du store (supprimes en fin de run, sauf KEEP_BUILD
# ou interruption).
.store-assets-build/

# Kits store, assets promo et outreach : jamais versionnes
DevKit/

# Visuels promotionnels : uniquement dans DevKit/store-images, jamais commités. Seules les quatre images
# du README restent suivies (le zip de l'extension exclut déjà ces deux dossiers : scripts/build-zip.mjs).
images/promo/*
!images/promo/marquee_1400x560.png
!images/promo/demo.gif
images/cws_screenshots/*
!images/cws_screenshots/EN/
images/cws_screenshots/EN/*
