{
  "name": "streampulse-extension",
  "version": "26.11.23",
  "private": true,
  "description": "Outillage de developpement de l'extension StreamPulse. Rien ici n'est package dans le zip livre au Chrome Web Store.",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "node scripts/verify.mjs",
    "store:assets": "node DevKit/scripts/make-store-assets.mjs",
    "publish:edge": "node DevKit/scripts/publish-edge.mjs",
    "publish:chrome": "node DevKit/scripts/publish-chrome.mjs",
    "publish:firefox": "node DevKit/scripts/publish-firefox.mjs",
    "publish:firefox:listing": "node DevKit/scripts/publish-firefox-listing.mjs",
    "publish:firefox:screenshots": "node DevKit/scripts/publish-firefox-screenshots.mjs",
    "listing": "node DevKit/scripts/prepare-listing.mjs",
    "store:chrome-kit": "node DevKit/scripts/make-chrome-kit.mjs",
    "store:edge-kit": "node DevKit/scripts/make-edge-kit.mjs",
    "publish:all": "node DevKit/scripts/publish-edge.mjs && node DevKit/scripts/publish-chrome.mjs && node DevKit/scripts/publish-firefox.mjs",
    "gen:i18n-inline": "node scripts/build-inline-i18n.mjs",
    "i18n:check": "node scripts/i18n/cli.mjs check",
    "i18n:sync": "node scripts/i18n/cli.mjs sync",
    "i18n:extract": "node scripts/i18n/cli.mjs extract",
    "i18n:translate": "node scripts/i18n/cli.mjs translate",
    "i18n:review": "node scripts/i18n/cli.mjs review",
    "i18n:apply-review": "node scripts/i18n/cli.mjs apply-review",
    "i18n:approve": "node scripts/i18n/cli.mjs approve",
    "i18n:validate": "node scripts/i18n/cli.mjs validate",
    "i18n:report": "node scripts/i18n/cli.mjs report",
    "i18n:pseudo": "node scripts/i18n/cli.mjs pseudo",
    "i18n:add": "node scripts/i18n/cli.mjs add",
    "i18n:publish": "node scripts/i18n/cli.mjs publish",
    "build": "npm run lint && npm run gen:i18n-inline && npm test && node scripts/build-zip.mjs",
    "promo:mp4": "node DevKit/scripts/render-tiktok-promo.mjs",
    "test": "node --test --test-concurrency=2 \"tests/*.test.mjs\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0"
  },
  "license": "UNLICENSED"
}
