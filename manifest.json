{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_appName__",
  "description": "__MSG_appDesc__",
  "version": "26.9.18",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "https://api.twitch.tv/*",
    "https://tmi.twitch.tv/*",
    "https://gql.twitch.tv/*",
    "https://www.twitch.tv/*",
    "https://clips.twitch.tv/*",
    "https://kick.com/*",
    "https://*.kick.com/*"
  ],
  "author": "AlexisAMZ",
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "all_frames": false,
      "js": [
        "js/inject/preventPause.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "all_frames": false,
      "js": [
        "js/inject/predictions-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "all_frames": false,
      "js": [
        "js/inject/i18n-inline.js",
        "js/inject/topbar-panel.js",
        "js/inject/settings-drawer.js",
        "js/inject/topbar.js",
        "js/inject/quickFollow.js",
        "js/inject/twitch-badge.js",
        "js/inject/chat-plus.js",
        "js/inject/sidebar-favorites.js"
      ],
      "css": [
        "css/topbar.css",
        "css/inject/twitch-badge.css",
        "css/inject/twitch-ui.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.twitch.tv/*",
        "https://clips.twitch.tv/*"
      ],
      "all_frames": false,
      "js": [
        "js/vendor/hls.light.min.js",
        "js/previews/sources.js",
        "js/previews/card.js",
        "js/previews/targets-twitch.js",
        "js/previews/observer.js",
        "js/previews/stream.js",
        "js/twitchPreviews.js"
      ],
      "css": [
        "css/previews.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "all_frames": false,
      "js": [
        "js/inject/i18n-inline.js",
        "js/channelPointsClaimer.js",
        "js/twitchPlayerEnhancer.js",
        "js/chatFilter.js",
        "js/watchTimeTracker.js",
        "js/tabEnhancer.js",
        "js/inject/predictionsOverlay.js",
        "js/inject/predictionsAssist.js"
      ],
      "run_at": "document_idle",
      "css": [
        "css/inject/predictions.css"
      ]
    },
    {
      "matches": [
        "https://kick.com/*",
        "https://*.kick.com/*"
      ],
      "all_frames": false,
      "js": [
        "js/inject/i18n-inline.js",
        "js/kickPlayerEnhancer.js",
        "js/kickChannelPoints.js",
        "js/chatFilter.js",
        "js/watchTimeTracker.js",
        "js/tabEnhancer.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "html/popup.html",
    "default_icon": {
      "16": "images/photos/16px.png",
      "32": "images/photos/32px.png",
      "48": "images/photos/48px.png",
      "128": "images/photos/128px.png"
    }
  },
  "icons": {
    "16": "images/photos/16px.png",
    "32": "images/photos/32px.png",
    "48": "images/photos/48px.png",
    "128": "images/photos/128px.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "images/photos/128px.png",
        "images/photos/logosp.png"
      ],
      "matches": [
        "https://www.twitch.tv/*"
      ]
    },
    {
      "resources": [
        "font/unbounded-latin-10.woff2",
        "font/unbounded-latin-ext-9.woff2",
        "font/onest-latin-6.woff2",
        "font/onest-latin-ext-5.woff2"
      ],
      "matches": [
        "https://www.twitch.tv/*",
        "https://clips.twitch.tv/*"
      ]
    },
    {
      "resources": [
        "js/predictions-data.js"
      ],
      "matches": [
        "https://www.twitch.tv/*"
      ]
    }
  ]
}
