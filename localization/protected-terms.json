{
  "$comment": "Ce qui ne passe JAMAIS au traducteur automatique. Seuls ces fragments sont masqués : le reste de la phrase est traduit normalement (« Your clip is ready » → seul rien n'est masqué, « Clip » est géré par le glossaire). Les termes communautaires qui se traduisent selon la langue (Drops, badge, raid, clip…) vont dans glossary.json, pas ici.",
  "patterns": [
    { "name": "mustache", "regex": "\\{\\{\\s*[^}\\s]+\\s*\\}\\}", "description": "Variables StreamPulse : {{count}}, {{name}}" },
    { "name": "template-literal", "regex": "\\$\\{[^}]+\\}", "description": "${variable} recopiée depuis du code" },
    { "name": "icu-brace", "regex": "\\{[A-Za-z_][\\w.]*\\}", "description": "{variable} à accolade simple" },
    { "name": "printf", "regex": "%(?:\\d+\\$)?[sdif]", "description": "%s, %d, %1$s" },
    { "name": "url", "regex": "https?://[^\\s\"'<>)]+", "description": "Adresses web" },
    { "name": "email", "regex": "[\\w.+-]+@[\\w-]+(?:\\.[\\w-]+)+", "description": "Adresses e-mail" },
    { "name": "handle", "regex": "(?<![\\w@])@[A-Za-z0-9_]{2,}", "description": "Pseudos (@AlexisAMZ)" },
    { "name": "domain", "regex": "\\b(?:streampulse|spclips)\\.(?:tech|com|fr)(?:/[^\\s\"'<>)]*)?", "description": "Domaines du produit écrits sans https://" },
    { "name": "newline", "regex": "\\n", "description": "Retour à la ligne voulu" }
  ],
  "terms": [
    { "term": "StreamPulse Clips", "category": "product", "caseSensitive": true },
    { "term": "StreamPulse+", "category": "product", "caseSensitive": true },
    { "term": "StreamPulse", "category": "product", "caseSensitive": true },
    { "term": "Chrome Web Store", "category": "brand", "caseSensitive": true },
    { "term": "Twitch", "category": "platform", "caseSensitive": false },
    { "term": "Kick", "category": "platform", "caseSensitive": true, "note": "Sensible à la casse : « kick » (verbe) n'est pas la plateforme." },
    { "term": "YouTube", "category": "platform", "caseSensitive": false },
    { "term": "CHZZK", "category": "platform", "caseSensitive": true, "aliases": { "ko": ["치지직"] }, "note": "En coréen, la plateforme s'appelle officiellement 치지직." },
    { "term": "TikTok", "category": "brand", "caseSensitive": false },
    { "term": "Instagram", "category": "brand", "caseSensitive": false },
    { "term": "Discord", "category": "brand", "caseSensitive": true },
    { "term": "ZEvent", "category": "brand", "caseSensitive": true },
    { "term": "Chrome", "category": "browser", "caseSensitive": true, "exemptKeys": ["popup.cosmetics.chrome"], "note": "Le navigateur. L'effet cosmétique « chrome » (popup.cosmetics.chrome) se traduit : clé exemptée." },
    { "term": "Edge", "category": "browser", "caseSensitive": true },
    { "term": "Firefox", "category": "browser", "caseSensitive": true },
    { "term": "Opera", "category": "browser", "caseSensitive": true },
    { "term": "Revolut", "category": "brand", "caseSensitive": true },
    { "term": "PayPal", "category": "brand", "caseSensitive": true },
    { "term": "Stripe", "category": "brand", "caseSensitive": true },
    { "term": "Google", "category": "brand", "caseSensitive": true },
    { "term": "API", "category": "technical", "caseSensitive": true },
    { "term": "OAuth", "category": "technical", "caseSensitive": true },
    { "term": "URL", "category": "technical", "caseSensitive": true },
    { "term": "JSON", "category": "technical", "caseSensitive": true },
    { "term": "CSV", "category": "technical", "caseSensitive": true },
    { "term": "HTTP", "category": "technical", "caseSensitive": true },
    { "term": "HTTPS", "category": "technical", "caseSensitive": true },
    { "term": "WebSocket", "category": "technical", "caseSensitive": true },
    { "term": "GraphQL", "category": "technical", "caseSensitive": true },
    { "term": "IRC", "category": "technical", "caseSensitive": true },
    { "term": "FPS", "category": "technical", "caseSensitive": true },
    { "term": "MP4", "category": "technical", "caseSensitive": true },
    { "term": "PNG", "category": "technical", "caseSensitive": true },
    { "term": "GIF", "category": "technical", "caseSensitive": true },
    { "term": "HTML", "category": "technical", "caseSensitive": true },
    { "term": "OBS", "category": "technical", "caseSensitive": true },
    { "term": "Webhook", "category": "technical", "caseSensitive": false }
  ],
  "identical": {
    "$comment": "required = la valeur DOIT rester celle de l'anglais (noms de plateformes affichés tels quels) ; allowed = elle PEUT rester identique sans être signalée. En plus, une chaîne faite uniquement de termes protégés, de variables, de chiffres et de ponctuation n'est jamais signalée.",
    "required": ["platforms.*", "popup.platformFilter.*"],
    "allowed": ["popup.cosmetics.sampleName"],
    "exceptions": { "ko": ["platforms.chzzk"] }
  }
}
