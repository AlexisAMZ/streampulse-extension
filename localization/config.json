    "pt-PT": { "label": "Português (Portugal)", "deepl": "PT-PT", "chrome": "pt_PT", "formality": "prefer_less" },
    "sv": { "label": "Svenska", "deepl": "SV", "chrome": "sv" },
    "cs": { "label": "Čeština", "deepl": "CS", "chrome": "cs" },
    "id": { "label": "Bahasa Indonesia", "deepl": "ID", "chrome": "id" }
  }
